<script data-purpose="modal-and-faq-logic">
    // FAQ Accordion Toggle Logic
    function toggleFaq(button) {
      const container = button.nextElementSibling;
      const svgIcon = button.querySelector('svg');
      const isExpanded = button.getAttribute('aria-expanded') === 'true';

      // Close all siblings for single accordion focus
      const allButtons = document.querySelectorAll('#faq-accordion-group button');
      allButtons.forEach(btn => {
        if (btn !== button) {
          btn.setAttribute('aria-expanded', 'false');
          btn.nextElementSibling.style.maxHeight = null;
          const icon = btn.querySelector('svg');
          if (icon) icon.classList.remove('rotate-180');
        }
      });

      // Toggle clicked
      if (isExpanded) {
        button.setAttribute('aria-expanded', 'false');
        container.style.maxHeight = null;
        svgIcon.classList.remove('rotate-180');
      } else {
        button.setAttribute('aria-expanded', 'true');
        container.style.maxHeight = container.scrollHeight + 'px';
        svgIcon.classList.add('rotate-180');
      }
    }

    // Modal Control Logic
    const modal = document.getElementById('registration-modal');
    const modalBox = document.getElementById('modal-box');
    const formView = document.getElementById('modal-form-view');
    const successView = document.getElementById('modal-success-view');

    function openModal() {
      modal.classList.remove('pointer-events-none', 'opacity-0');
      modal.classList.add('opacity-100');
      modalBox.classList.remove('scale-95');
      modalBox.classList.add('scale-100');
      document.body.style.overflow = 'hidden';
    }

    function closeModal() {
      modal.classList.add('opacity-0');
      modal.classList.add('pointer-events-none');
      modal.classList.remove('opacity-100');
      modalBox.classList.remove('scale-100');
      modalBox.classList.add('scale-95');
      document.body.style.overflow = '';
      
      // Reset view after transition
      setTimeout(() => {
        formView.classList.remove('hidden');
        successView.classList.add('hidden');
      }, 300);
    }

    // Close on backdrop click
    modal.addEventListener('click', (e) => {
      if (e.target === modal) {
        closeModal();
      }
    });

    // Close on Escape Key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !modal.classList.contains('pointer-events-none')) {
        closeModal();
      }
    });

    // Form Submission Handling with simulated API state
    function handleFormSubmit(event) {
      event.preventDefault();
      const submitBtn = document.getElementById('submit-btn');
      
      // Set loading state
      const originalText = submitBtn.innerHTML;
      submitBtn.disabled = true;
      submitBtn.innerHTML = `
        <svg class="animate-spin -ml-1 mr-2 h-4 w-4 text-black" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
        </svg>
        <span>Processing Registration...</span>
      `;

      // Simulate Network Request
      setTimeout(() => {
        submitBtn.disabled = false;
        submitBtn.innerHTML = originalText;
        
        // Show success view
        formView.classList.add('hidden');
        successView.classList.remove('hidden');
      }, 750);
    }
  </script>
<!-- END: InteractiveHandlersScript -->
